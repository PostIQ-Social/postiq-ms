    "PostSyncJob": {
      "Enabled": true,
      "Schedule": "1min",
      "QueueSize": 1,
      "MaxConcurrentConsumers": 1,
      "FullMode": "Wait"
    }
  },

  "HttpClientSettings": {
    "Clients": {
      "PublishedClient": {
        "BaseAddress": "https://localhost:7103/api/v1/",
        "Timeout": "00:05:00",
        "BufferSize": 81920,
        "MaxResponseContentBufferSize": 0,
        "DefaultHeaders": {
          "Accept": "application/json"
        }
      }
    }
  },
  "BackgroundJobs": {
    "Defaults": {
      "Enabled": true,
      "QueueSize": 100,
      "MaxConcurrentConsumers": 5,
      "FullMode": "Wait",
      "ProductionIntervalMs": 60000
